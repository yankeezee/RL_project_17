README.md text eol=lf
.gitattributes text eol=lf
INTEGRATION.md text eol=lf
replay/** text eol=lf
demo/** text eol=lf

# Generated evidence contains byte-level SHA-256 provenance. Preserve its bytes
# on Windows and Linux instead of converting CSV/JSON line endings at checkout.
replay/results/** -text whitespace=cr-at-eol
demo/output/** -text whitespace=cr-at-eol

*.png binary
*.gif binary
*.mp4 binary
